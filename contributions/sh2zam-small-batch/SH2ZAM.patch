index 0000000..6bd801a
--- /dev/null
+++ b/saturn/benchmarks/small-batch/small_batch.h
@@ -0,0 +1,31 @@
+/* MIT; synthetic furniture-sized fixtures, no asset data. */
+#ifndef SH2Z_SMALL_BATCH_H
+#define SH2Z_SMALL_BATCH_H
+#include <sh2zam/batch_experimental.h>
+#include <sh2zam/reuse_experimental.h>
+#include <sh2zam/box_experimental.h>
+#include <sh2zam/divu_experimental.h>
+#define SB_MAX 256
+#define SB_KERNELS 9
+typedef struct {
+    sh2z_vec3_t in[SB_MAX],out[SB_MAX],reference[SB_MAX];
+    sh2z_aabb_t boxes[SB_MAX/8];
+    sh2z_mat34_t matrix;
+    sh2z_mesh_view_t view;
+    sh2z_transform_plan_t plan;
+    sh2z_reuse_mesh_t reuse;
+    sh2z_reuse_plan_t reuse_plan;
+    sh2z_reuse_index_t indices[SB_MAX];
+    sh2z_fx_t x_keys[SB_MAX];
+    sh2z_reuse_yz_t yz_keys[SB_MAX];
+    sh2z_reuse_term_t x_terms[SB_MAX],yz_terms[SB_MAX];
+    size_t count;
+} sb_workspace;
+extern const char *const sb_names[SB_KERNELS];
+bool sb_init(sb_workspace *w,size_t count);
+bool sb_run(sb_workspace *w,unsigned kernel);
+uint32_t sb_hash(const sh2z_vec3_t *p,size_t count);
+bool sb_correct(const sb_workspace *w);
+/* Returns number of failures; logical save/restore sequence, not ISR testing. */
+unsigned sb_check_divu(void);
+#endif
diff --git a/saturn/include/sh2zam/box_experimental.h b/saturn/include/sh2zam/box_experimental.h
new file mode 100644
index 0000000..3e9b5e5
--- /dev/null
+++ b/saturn/include/sh2zam/box_experimental.h
@@ -0,0 +1,23 @@
+/* Exact eight-corner transforms. MIT; SH2ZAM Contributors. */
+#ifndef SH2ZAM_BOX_EXPERIMENTAL_H
+#define SH2ZAM_BOX_EXPERIMENTAL_H
+#include "sh2zam.h"
+#ifdef __cplusplus
+extern "C" {
+#endif
+/** Transform all corners of an ordered Q16.16 AABB. Corner index bits select
+ * max X (bit 0), max Y (bit 1), max Z (bit 2); clear bits select min.
+ * Exactly matches transform_points_general: floor the full dot once, add
+ * translation, saturate. Supports all int32 values, including degenerate boxes.
+ * Reuses endpoint products when each basis row's magnitude sum fits uint32;
+ * otherwise uses the full-range scalar fallback. No allocation or MMIO.
+ * All pointers require natural alignment. out has eight elements and must be
+ * disjoint from matrix and box. Null, overlap or reversed bounds return false
+ * before any write. Inputs may overlap each other (both are read-only).
+ * Experimental: fewer products do not guarantee lower SH-2 elapsed time. */
+bool sh2z_mat34_transform_box8(sh2z_vec3_t *out,
+    const sh2z_mat34_t *matrix,const sh2z_aabb_t *box);
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git a/saturn/include/sh2zam/divu_experimental.h b/saturn/include/sh2zam/divu_experimental.h
index 5f10434..9a56c8c 100644
--- a/saturn/include/sh2zam/divu_experimental.h
+++ b/saturn/include/sh2zam/divu_experimental.h
@@ -147,6 +147,20 @@ static inline void sh2z_divu_restore(const sh2z_divu_state_t *s) {
 #endif
 }
 
+/** Explicit Q16.16 division with the scalar sh2z_div result rules, including
+ *  0/0 == 0. overflow is true for zero divisors or the conservative raw-DIVU
+ *  bound (including exact INT32_MIN). Same ownership/OVFIE rules as start64.
+ *  No implicit default dispatch: callers opt into MMIO by using this API. */
+static inline void sh2z_divu_start16(sh2z_divu_t *t,sh2z_fx_t a,sh2z_fx_t b) {
+    if(a==0&&b==0) {
+        t->quotient=0;t->in_software=1;t->overflow=1;return;
+    }
+    /* Signed high word of a * 65536, without signed shifts or libgcc. */
+    const int32_t hi=(int32_t)((uint32_t)a>>16)-(a<0?65536:0);
+    sh2z_divu_start64(t,hi,(uint32_t)a<<16,b);
+}
+sh2z_fx_t sh2z_divu_div16(sh2z_fx_t a,sh2z_fx_t b,bool *overflow);
+
 /** Blocking signed 64/32 division with the result rule above. overflow may
  *  be null. On SH-2 this uses the divider between its own start and finish. */
 int32_t sh2z_divu_div64(int64_t n,int32_t divisor,bool *overflow);
diff --git a/saturn/src/sh2zam_box.c b/saturn/src/sh2zam_box.c
new file mode 100644
index 0000000..f8ffdf0
--- /dev/null
+++ b/saturn/src/sh2zam_box.c
@@ -0,0 +1,43 @@
+/* MIT; SH2ZAM Contributors. */
+#include "sh2zam/box_experimental.h"
+#include "sh2zam_internal.h"
+#include "sh2zam_prepared_internal.h"
+
+bool sh2z_mat34_transform_box8(sh2z_vec3_t *out,
+    const sh2z_mat34_t *matrix,const sh2z_aabb_t *box) {
+    if(!out||!matrix||!box)return false;
+    if(sh2zi_prepared_overlap(out,8*sizeof(*out),matrix,sizeof(*matrix))||
+       sh2zi_prepared_overlap(out,8*sizeof(*out),box,sizeof(*box)))return false;
+    if(box->min.x>box->max.x||box->min.y>box->max.y||box->min.z>box->max.z)return false;
+    bool bounded=true;
+    for(unsigned r=0;r<3;r++) {
+        uint32_t a=sh2zi_magnitude(matrix->m[r][0]);
+        uint32_t b=sh2zi_magnitude(matrix->m[r][1]);
+        uint32_t c=sh2zi_magnitude(matrix->m[r][2]);
+        if(a>UINT32_MAX-b||a+b>UINT32_MAX-c)bounded=false;
+    }
+    if(!bounded) {
+        for(unsigned i=0;i<8;i++) {
+            sh2z_vec3_t v={i&1?box->max.x:box->min.x,
+                i&2?box->max.y:box->min.y,i&4?box->max.z:box->min.z};
+            out[i]=sh2z_mat34_transform_point(matrix,v);
+        }
+        return true;
+    }
+    /* The gate bounds every partial sum by 2^63-2^31, for ANY input.
+     * Translation is added after flooring, with ample int64 headroom. */
+    for(unsigned r=0;r<3;r++) {
+        const int32_t *m=matrix->m[r];
+        const int64_t x0=sh2zi_product(m[0],box->min.x),x1=sh2zi_product(m[0],box->max.x);
+        const int64_t y0=sh2zi_product(m[1],box->min.y),y1=sh2zi_product(m[1],box->max.y);
+        const int64_t z[2]={sh2zi_product(m[2],box->min.z),sh2zi_product(m[2],box->max.z)};
+        const int64_t xy[4]={x0+y0,x1+y0,x0+y1,x1+y1};
+        for(unsigned i=0;i<8;i++) {
+            const int32_t value=sh2zi_clamp(sh2zi_floor16(xy[i&3]+z[i>>2])+m[3]);
+            if(r==0)out[i].x=value;
+            else if(r==1)out[i].y=value;
+            else out[i].z=value;
+        }
+    }
+    return true;
+}
diff --git a/saturn/src/sh2zam_divu.c b/saturn/src/sh2zam_divu.c
