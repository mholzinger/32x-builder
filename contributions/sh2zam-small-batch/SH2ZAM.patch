+}
diff --git a/saturn/tests/test_box.c b/saturn/tests/test_box.c
new file mode 100644
index 0000000..d4e3e94
--- /dev/null
+++ b/saturn/tests/test_box.c
@@ -0,0 +1,43 @@
+/* Independent full-range oracle, including cancellation. MIT. */
+#include <sh2zam/box_experimental.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+/* __int128 is a host-test requirement, never used in the library. */
+__extension__ typedef __int128 wide;
+#define CHECK(x) do { if(!(x)){fprintf(stderr,"line %d\n",__LINE__);exit(1);} } while(0)
+static uint32_t rng=12345;
+static int32_t next(void){rng^=rng<<13;rng^=rng>>17;rng^=rng<<5;return (int32_t)rng;}
+static int32_t oracle(const int32_t *m,sh2z_vec3_t v) {
+    wide n=(wide)m[0]*v.x+(wide)m[1]*v.y+(wide)m[2]*v.z;
+    wide q=n/65536;if(n<0&&n%65536)q--;
+    q+=m[3];return q>INT32_MAX?INT32_MAX:q<INT32_MIN?INT32_MIN:(int32_t)q;
+}
+int main(void) {
+    sh2z_vec3_t out[8],saved[8];
+    const int32_t edges[]={INT32_MIN,INT32_MIN+1,-65537,-1,0,1,65535,INT32_MAX};
+    for(unsigned t=0;t<20000;t++) {
+        sh2z_mat34_t m;
+        for(unsigned r=0;r<3;r++)for(unsigned c=0;c<4;c++)
+            m.m[r][c]=t<512?edges[(t+r*3+c)%8]:t&1?next():next()/4096;
+        sh2z_vec3_t a={next(),next(),next()},b={next(),next(),next()};
+        sh2z_aabb_t box={{a.x<b.x?a.x:b.x,a.y<b.y?a.y:b.y,a.z<b.z?a.z:b.z},
+                        {a.x>b.x?a.x:b.x,a.y>b.y?a.y:b.y,a.z>b.z?a.z:b.z}};
+        if(t%7==0)box.max=box.min;
+        CHECK(sh2z_mat34_transform_box8(out,&m,&box));
+        for(unsigned i=0;i<8;i++) {
+            sh2z_vec3_t v={i&1?box.max.x:box.min.x,i&2?box.max.y:box.min.y,i&4?box.max.z:box.min.z};
+            CHECK(out[i].x==oracle(m.m[0],v)&&out[i].y==oracle(m.m[1],v)&&out[i].z==oracle(m.m[2],v));
+        }
+    }
+    sh2z_mat34_t m=sh2z_mat34_identity();sh2z_aabb_t box={{1,0,0},{0,0,0}};
+    memcpy(saved,out,sizeof out);
+    CHECK(!sh2z_mat34_transform_box8(out,&m,&box));CHECK(!memcmp(saved,out,sizeof out));
+    box.min.x=0;
+    CHECK(!sh2z_mat34_transform_box8(NULL,&m,&box));
+    CHECK(!sh2z_mat34_transform_box8(out,NULL,&box));
+    CHECK(!sh2z_mat34_transform_box8(out,&m,NULL));
+    CHECK(!sh2z_mat34_transform_box8((sh2z_vec3_t *)&m,&m,&box));
+    CHECK(!sh2z_mat34_transform_box8((sh2z_vec3_t *)&box,&m,&box));
+    puts("160000 box corners match independent wide oracle");return 0;
+}
