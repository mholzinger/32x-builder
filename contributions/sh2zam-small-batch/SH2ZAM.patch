+/* MIT; independent Q16 oracle with explicit zero and saturation cases. */
+#include <sh2zam/divu_experimental.h>
+#include <stdio.h>
+#include <stdlib.h>
+#define CHECK(x) do { if(!(x)){fprintf(stderr,"line %d\n",__LINE__);exit(1);} } while(0)
+static uint32_t rng=7169;
+static int32_t next(void){rng^=rng<<13;rng^=rng>>17;rng^=rng<<5;return (int32_t)rng;}
+static void check(int32_t a,int32_t b) {
+    int64_t q=b?((int64_t)a*65536)/b:a<0?INT32_MIN:a>0?INT32_MAX:0;
+    int32_t expected=q>INT32_MAX?INT32_MAX:q<INT32_MIN?INT32_MIN:(int32_t)q;
+    bool overflow=false;sh2z_divu_t t;sh2z_divu_start16(&t,a,b);
+    CHECK(sh2z_divu_finish(&t,&overflow)==expected);
+    CHECK(overflow==(b==0||q>=INT64_C(2147483648)||q<=-INT64_C(2147483648)));
+    CHECK(sh2z_divu_div16(a,b,NULL)==expected);
+    CHECK(sh2z_div(a,b)==expected);
+}
+int main(void) {
+    const int32_t e[]={INT32_MIN,INT32_MIN+1,-65536,-1,0,1,65536,INT32_MAX};
+    for(unsigned i=0;i<8;i++)for(unsigned j=0;j<8;j++)check(e[i],e[j]);
+    for(unsigned i=0;i<100000;i++){int32_t a=next(),b=next();check(a,b);}
+    puts("100064 Q16 divisions match independent oracle");return 0;
+}
