diff --git a/saturn/benchmarks/small-batch/README.md b/saturn/benchmarks/small-batch/README.md
new file mode 100644
index 0000000..edaff41
--- /dev/null
+++ b/saturn/benchmarks/small-batch/README.md
@@ -0,0 +1,70 @@
+# Small batches and box endpoint reuse
+
+This is a correctness and target-timing fixture, not a desktop speed ranking.
+The synthetic repeated AABBs contain no game assets. Counts are 8, 24 (three
+boxes / desk-sized), 28 (intro-sized), 48 (six boxes), 72 (nine boxes /
+chair-sized), 128 and 256 vertices. The last four vertices in the 28 case
+use the scalar tail. Repeated identical dimensions deliberately favor generic
+coordinate reuse at the two larger counts; these are not representative scene
+frequency measurements. Corner order uses binary X/Y/Z bits, so the upstream
+`blocks8` pattern is intentionally not selected.
+
+Build from the repository root:
+
+```sh
+cmake -S . -B build -DSH2Z_STRICT=ON -DCMAKE_BUILD_TYPE=Release
+cmake --build build -j
+ctest --test-dir build --output-on-failure
+./build/saturn/sh2zam_small_batch
+```
+
+`small_batch.c/.h` are platform-independent; the host executable emits fixture
+hashes, never host performance claims. A target frontend provides a timer,
+keeps the workspace naturally aligned and measures `sb_run`. It must check
+`sb_correct` outside timing and retain/report the output hash. State is caller
+owned; the fixed-capacity host workspace is 27,776 bytes on arm64 and varies
+with ABI. It is benchmark infrastructure, not library allocation.
+
+| Path | Work included in each timed call |
+|---|---|
+| GENERAL | Full-range scalar batch |
+| BATCH | Matrix gate and ordinary fused batch |
+| COLD-PREP | Position scan, plan initialization, prepared execution |
+| WARM-PREP | Plan initialization and prepared execution; immutable mesh metadata cached |
+| EXEC-ONLY | Prepared execution only; a lower bound when the matrix changes every frame |
+| MAC-PREP / DMUL-PREP | Plan initialization and explicit candidate execution |
+| REUSE | Matrix update, all contribution table rebuilds and execution |
+| BOX8 | Bounds/alias checks, endpoint products and execution, scalar partial tail |
+
+`sb_init` performs immutable-mesh preparation before timing. Report that startup
+cost separately if mesh construction is part of the workload. REUSE must report
+`reuse_plan.enabled`: upstream's count >=128 gate means the smaller cases use
+prepared fallback, even though they have repeated coordinates. Availability
+queries must run on the executing CPU; MAC requires SR.S clear. No silent
+algorithm dispatch or saturation-mode changes are introduced.
+
+The added box API shares 18 endpoint products rather than 72 per box. The
+full-range result remains floor-once, translated, saturated Q16.16. It is
+experimental: output stores, wide arithmetic, checks and setup can dominate.
+It is not an animated arbitrary mesh transform, and tapered/wedge geometry
+must use an ordinary vertex path.
+
+The Q16 DIVU wrapper is explicitly selected. It preserves scalar `sh2z_div`
+zero behavior, including 0/0=0, without changing the existing raw64 API.
+Hardware ownership, interrupt preservation and OVFIE rules remain those in
+`divu_experimental.h`. `sb_check_divu` checks 320 edge/random operand pairs and
+one simulated interrupt save/use/restore sequence. It does not qualify a real
+interrupt handler or physical SH7604 silicon.
+
+A 32X frontend and MiSTer evidence are maintained with the integration package
+in 32x-builder. That frontend parks CPU2 in BIOS, reuses title scratch, warms
+each path eight times and measures 64 calls using the primary FRT at Phi/128.
+All candidates are in the same ROM; variants change only diagnostic byte 31.
+Each individual call must finish before the 16-bit timer wraps (~365 ms).
+Timer-read/call overhead remains in results. Report min/max and repeat passes.
+The divider page measures 32 operations per call with identical independent
+integer work; DIV1, blocking Q16 DIVU, split Q16 DIVU and raw64 DIVU all check
+the same hash. Split timing exposes overlap opportunity, not a guarantee.
+
+MiSTer is an FPGA core, not a physical Saturn/32X SH7604. Do not promote these
+numbers to silicon timings, whole-game FPS, or a general SH2ZAM speedup.
diff --git a/saturn/benchmarks/small-batch/host.c b/saturn/benchmarks/small-batch/host.c
new file mode 100644
index 0000000..fa02a34
--- /dev/null
+++ b/saturn/benchmarks/small-batch/host.c
@@ -0,0 +1,15 @@
+/* Correctness/fixture manifest only. Host speed is not SH-2 performance. MIT. */
+#include "small_batch.h"
+#include <stdio.h>
+static sb_workspace w;
+int main(void) {
+    const unsigned counts[]={8,24,28,48,72,128,256};
+    for(unsigned c=0;c<7;c++) {
+        if(!sb_init(&w,counts[c]))return 1;
+        for(unsigned k=0;k<SB_KERNELS;k++)if(!sb_run(&w,k)||!sb_correct(&w))return 2;
+        printf("count=%u hash=%08x reuse=%u blocks8=%u workspace=%zu\n",
+            counts[c],(unsigned)sb_hash(w.reference,w.count),w.reuse_plan.enabled?1u:0u,
+            w.reuse.blocks8?1u:0u,sizeof w);
+    }
+    return sb_check_divu()?3:0;
+}
diff --git a/saturn/benchmarks/small-batch/small_batch.c b/saturn/benchmarks/small-batch/small_batch.c
new file mode 100644
index 0000000..4995e50
--- /dev/null
+++ b/saturn/benchmarks/small-batch/small_batch.c
@@ -0,0 +1,83 @@
+/* MIT; all per-matrix setup is inside sb_run except EXEC-ONLY. */
+#include "small_batch.h"
+const char *const sb_names[SB_KERNELS]={"GENERAL","BATCH","COLD-PREP","WARM-PREP",
+    "EXEC-ONLY","MAC-PREP","DMUL-PREP","REUSE","BOX8"};
+bool sb_init(sb_workspace *w,size_t count) {
+    if(!w||!count||count>SB_MAX)return false;
+    w->count=count;
+    w->matrix=(sh2z_mat34_t){{{56756,-8192,31744,12345},
+        {16384,61517,-8192,-8193},{-30000,15000,56756,200000}}};
+    for(size_t b=0;b<(count+7)/8;b++) {
+        /* Repeated dimensions keep a deliberately reuse-friendly fixture.
+         * Batches <128 still exercise the current generic cost fallback. */
+        sh2z_aabb_t box={{-131073,-65537,-98305},{131071,196607,65535}};
+        w->boxes[b]=box;
+        for(unsigned i=0;i<8&&b*8+i<count;i++)w->in[b*8+i]=(sh2z_vec3_t){
+            i&1?box.max.x:box.min.x,i&2?box.max.y:box.min.y,i&4?box.max.z:box.min.z};
+    }
+    return sh2z_mat34_transform_points_general(w->reference,&w->matrix,w->in,count)&&
+        sh2z_mesh_view_init(&w->view,w->in,count)&&
+        sh2z_transform_plan_init(&w->plan,&w->view,&w->matrix)&&
+        sh2z_reuse_mesh_init(&w->reuse,w->in,count,w->indices,SB_MAX,
+            w->x_keys,SB_MAX,w->yz_keys,SB_MAX)&&
+        sh2z_reuse_plan_init(&w->reuse_plan,&w->reuse,&w->matrix,
+            w->x_terms,SB_MAX,w->yz_terms,SB_MAX);
+}
+bool sb_run(sb_workspace *w,unsigned kernel) {
+    switch(kernel) {
+    case 0:return sh2z_mat34_transform_points_general(w->out,&w->matrix,w->in,w->count);
+    case 1:return sh2z_mat34_transform_points(w->out,&w->matrix,w->in,w->count);
+    case 2:if(!sh2z_mesh_view_init(&w->view,w->in,w->count))return false;
+        /* fall through */
+    case 3:if(!sh2z_transform_plan_init(&w->plan,&w->view,&w->matrix))return false;
+        /* fall through */
+    case 4:return sh2z_transform_plan_execute(w->out,&w->plan);
+    case 5:return sh2z_transform_plan_init(&w->plan,&w->view,&w->matrix)&&
+        sh2z_transform_plan_execute_mac(w->out,&w->plan,0,w->count);
+    case 6:return sh2z_transform_plan_init(&w->plan,&w->view,&w->matrix)&&
+        sh2z_transform_plan_execute_dmuls(w->out,&w->plan,0,w->count);
+    case 7:return sh2z_reuse_plan_update_matrix(&w->reuse_plan,&w->matrix)&&
+        sh2z_reuse_plan_execute(w->out,&w->reuse_plan);
+    case 8: {
+        size_t b;
+        for(b=0;b<w->count/8;b++)
+            if(!sh2z_mat34_transform_box8(w->out+b*8,&w->matrix,w->boxes+b))return false;
+        return sh2z_mat34_transform_points_general(w->out+b*8,&w->matrix,w->in+b*8,w->count-b*8);
+    }
+    default:return false;
+    }
+}
+uint32_t sb_hash(const sh2z_vec3_t *p,size_t count) {
+    uint32_t h=2166136261u;
+    for(size_t i=0;i<count;i++) {
+        h=(h^(uint32_t)p[i].x)*16777619u;
+        h=(h^(uint32_t)p[i].y)*16777619u;
+        h=(h^(uint32_t)p[i].z)*16777619u;
+    }
+    return h;
+}
+bool sb_correct(const sb_workspace *w) {
+    for(size_t i=0;i<w->count;i++)if(w->out[i].x!=w->reference[i].x||
+        w->out[i].y!=w->reference[i].y||w->out[i].z!=w->reference[i].z)return false;
+    return true;
+}
+unsigned sb_check_divu(void) {
+    const int32_t e[]={INT32_MIN,INT32_MIN+1,-65536,-1,0,1,65536,INT32_MAX};
+    unsigned failures=0;uint32_t seed=7169;
+    for(unsigned i=0;i<320;i++) {
+        int32_t a,b;
+        if(i<64){a=e[i/8];b=e[i%8];}
+        else {seed=seed*1664525u+1013904223u;a=(int32_t)seed;
+            seed=seed*1664525u+1013904223u;b=(int32_t)seed;}
+        int32_t ref=sh2z_div(a,b);
+        sh2z_divu_t t;sh2z_divu_start16(&t,a,b);
+        if(sh2z_divu_finish(&t,0)!=ref)failures++;
+        if(sh2z_divu_div16(a,b,0)!=ref)failures++;
+    }
+    sh2z_divu_t outer,inner;sh2z_divu_state_t saved;
+    sh2z_divu_start16(&outer,1234567,98765);sh2z_divu_save(&saved);
+    sh2z_divu_start16(&inner,-7654321,123456);(void)sh2z_divu_finish(&inner,0);
+    sh2z_divu_restore(&saved);
+    if(sh2z_divu_finish(&outer,0)!=sh2z_div(1234567,98765))failures++;
+    return failures;
+}
diff --git a/saturn/benchmarks/small-batch/small_batch.h b/saturn/benchmarks/small-batch/small_batch.h
