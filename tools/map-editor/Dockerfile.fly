# Self-contained image for fly.io (built from the REPO ROOT as context, so it
# can bundle the data the app reads at runtime — there's no volume mount on fly).
# Deploy: ./deploy-to-flyio.sh  (or: fly deploy) from the repo root.
FROM python:3.11-slim
WORKDIR /app

COPY tools/map-editor/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# The editor app itself (github_pr.py = the OAuth/PR module beside app.py).
COPY tools/map-editor/app.py tools/map-editor/config.py \
     tools/map-editor/github_pr.py /app/
COPY tools/map-editor/templates/ /app/templates/
COPY tools/map-editor/static/ /app/static/

# Repo bits the app reads at runtime (MAP_REPO_ROOT=/repo). export_assets parses
# the palette + baked textures straight out of these engine sources.
COPY registry.json /repo/registry.json
COPY maps/ /repo/maps/
COPY tools/mapfmt.py tools/export_assets.py tools/lint_maps.py \
     tools/bake_sprite.py /repo/tools/
# The whole sh_src tree (11 MB build-time): export_assets reads the palette
# and every baked texture from here, INCLUDING community spr_*_tex.h standees
# — a glob COPY would fail the build while none exist yet, and cherry-picked
# lists (the old style) silently dropped new sprites from the preview.
COPY sh_src/ /repo/sh_src/

EXPOSE 5050
ENV MAP_HOST=0.0.0.0 \
    MAP_PORT=5050 \
    MAP_REPO_ROOT=/repo \
    MAP_READONLY=1 \
    PYTHONUNBUFFERED=1
CMD ["python", "app.py"]
